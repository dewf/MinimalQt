module Label;

import Object;
import Common;
import Frame;
import Icon;
import Enums;
import Pixmap;
import Widget;

interface SignalHandler extends Frame.SignalHandler {
    void linkActivated(string link);
    void linkHovered(string link);
}

opaque Handle extends Frame.Handle {
    // properties =================
    Alignment alignment();
    void setAlignment(Alignment align);
    
    bool hasSelectedText();
    // read-only

    int indent();
    void setIndent(int indent);
    
    int margin();
    void setMargin(int margin);

    bool openExternalLinks();
    void setOpenExternalLinks(bool state);

    Pixmap.Owned getPixmap();
    void setPixmap(Pixmap.Handle pixmap);

    bool hasScaledContents();
    void setScaledContents(bool state);
    
    string selectedText();
    // read-only

    string text();
    void setText(string text);

    TextFormatEnum getTextFormat();
    void setTextFormat(TextFormatEnum format);

    TextInteractionFlags getTextInteractionFlags();
    void setTextInteractionFlags(TextInteractionFlags interactionFlags);

    bool wordWrap();
    void setWordWrap(bool state);

    // quasi-properties ===========
    Widget.Handle buddy();
    void setBuddy(Widget.Handle buddy);

    // QMovie * movie() const
    // void setMovie(QMovie *movie)

    // QPicture picture() const
    // void setPicture(const QPicture &picture)

    // QTextDocument::ResourceProvider resourceProvider() const
    // void setResourceProvider(const QTextDocument::ResourceProvider &provider)

    int selectionStart();
    // read-only

    // methods ============================
    void clear();
    void setSelection(int start, int length);
    void setNum(int num);
    void setNum(double num);

    // signals ============================
    SignalConnection connect_LinkActivated(SignalHandler handler);
    SignalConnection connect_LinkHovered(SignalHandler handler);
}

options CreateOptions {
    Widget.Handle parent;
    WindowFlags flags_;
}

Handle create(CreateOptions opts);
Handle create(string text, CreateOptions opts);
