module ScrollArea;

import Object;
import Widget;
import Enums;
import AbstractScrollArea;

interface SignalHandler extends AbstractScrollArea.SignalHandler;
// none extra

opaque Handle extends AbstractScrollArea.Handle {
    Alignment getAlignment();
    void ensureVisible(int x, int y, Option<int> xmargin, Option<int> ymargin);
    void ensureWidgetVisible(Widget.Handle childWidget, Option<int> xmargin, Option<int> ymargin);
    void setAlignment(Alignment align);
    void setWidget(Widget.Handle widget);
    void setWidgetResizable(bool resizable);
    Widget.Handle takeWidget();
    Widget.Handle widget();
    bool widgetResizable();
}

Handle create(Option<Widget.Handle> parent);
