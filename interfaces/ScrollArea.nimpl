import Icon;
import Enums;
import Widget;
import AbstractScrollArea;

namedbits SignalMask extends AbstractScrollArea.SignalMask {
    // none extra
}

interface SignalHandler extends AbstractScrollArea.SignalHandler {
    // (none)
