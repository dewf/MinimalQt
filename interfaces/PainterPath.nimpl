module PainterPath;

import Common;
import PointF2;
import Enums;
import Region;
import Font;
import PolygonF;
import Transform;

@nodispose
opaque Handle {
    void addEllipse(RectF boundingRectangle);
    void addEllipse(PointF2.Handle center, double rx, double ry);
    void addEllipse(double x, double y, double width, double height);
    void addPath(Handle path);
    void addPolygon(PolygonF.Handle polygon);
    void addRect(RectF rectangle);
    void addRect(double x, double y, double width, double height);
    void addRegion(Region.Handle region);
    void addRoundedRect(RectF rect, double xRadius, double yRadius, SizeMode mode = AbsoluteSize);
    void addRoundedRect(double x, double y, double w, double h, double xRadius, double yRadius, SizeMode mode = AbsoluteSize);
    void addText(PointF2.Handle point, Font.Handle font, string text);
    void addText(double x, double y, Font.Handle font, string text);
    double angleAtPercent(double t);
    void arcMoveTo(RectF rectangle, double angle);
    void arcMoveTo(double x, double y, double width, double height, double angle);
    void arcTo(RectF rectangle, double startAngle, double sweepLength);
    void arcTo(double x, double y, double width, double height, double startAngle, double sweepLength);
    RectF boundingRect();
    int capacity();
    void clear();
    void closeSubpath();
    void connectPath(Handle path);
    bool contains(Handle p);
    bool contains(PointF2.Handle point);
    bool contains(RectF rectangle);
    RectF controlPointRect();
    void cubicTo(PointF2.Handle c1, PointF2.Handle c2, PointF2.Handle endPoint);
    void cubicTo(double c1X, double c1Y, double c2X, double c2Y, double endPointX, double endPointY);
    PointF2.Owned currentPosition();

    // QPainterPath::Element elementAt(int index) const

    int elementCount();
    FillRule fillRule();
    Owned intersected(Handle p);
    bool intersects(Handle p);
    bool intersects(RectF rectangle);
    bool isEmpty();
    double length();
    void lineTo(PointF2.Handle endPoint);
    void lineTo(double x, double y);
    void moveTo(PointF2.Handle point);
    void moveTo(double x, double y);
    double percentAtLength(double len);
    PointF2.Owned pointAtPercent(double t);
    void quadTo(PointF2.Handle c, PointF2.Handle endPoint);
    void quadTo(double cx, double cy, double endPointX, double endPointY);
    void reserve(int size);
    void setElementPositionAt(int index, double x, double y);
    void setFillRule(FillRule fillRule);
    Owned simplified();
    double slopeAtPercent(double t);
    Owned subtracted(Handle p);
    PolygonF.Owned toFillPolygon(Transform.Handle matrix = null);
    Array<PolygonF.Owned> toFillPolygons(Transform.Handle matrix = null);
    Owned toReversed();
    Array<PolygonF.Owned> toSubpathPolygons(Transform.Handle matrix = null);
    void translate(double dx, double dy);
    void translate(PointF2.Handle offset);
    Owned translated(double dx, double dy);
    Owned translated(PointF2.Handle offset);
    Owned united(Handle p);
}

opaque Owned extends Handle;

Owned create();
Owned create(PointF2.Handle startPoint);
Owned create(Handle path);
