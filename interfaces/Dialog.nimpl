module Dialog;

import Object;
import Common;
import Icon;
import Widget;

interface SignalHandler extends Widget.SignalHandler {
    void accepted();
    void finished(int result);
    void rejected();
}

enum DialogCode {
    Accepted = 1,
    Rejected = 0
}

opaque Handle extends Widget.Handle {
    // isModal in Widget
    void setModal(bool state);

    bool isSizeGripEnabled();
    void setSizeGripEnabled(bool enabled);

    // a version where we're setting WindowFlags (Qt::Dialog) - otherwise it won't work
    // ?? forget what this was for. nested dialogs I think?
    void setParentDialogFlags(Widget.Handle parent);

    int result();
    void setResult(int result);
    void accept();
    void done(int result);
    void reject();
    int exec();

    // signals ============================
    SignalConnection connect_Accepted(SignalHandler handler);
    SignalConnection connect_Finished(SignalHandler handler);
    SignalConnection connect_Rejected(SignalHandler handler);
}

Handle create(Widget.Handle parent);
