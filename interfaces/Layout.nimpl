module Layout;

import Object;
import Common;
import Enums;

namedbits SignalMask extends Object.SignalMask {
    // none extra
}

interface SignalHandler extends Object.SignalHandler {
    // none of our own
}

enum SizeConstraint {
    SetDefaultConstraint,
    SetNoConstraint,
    SetMinimumSize,
    SetFixedSize,
    SetMaximumSize,
    SetMinAndMaxSize
}

fwdopaque WidgetHandle = Widget.Handle;

// TODO: inherit from LayoutItem instead? an issue since we can't do multiple inheritance, and IIRC LayoutItem doesn't inherit QObject
@nodispose
opaque Handle extends Object.Handle {
    // properties =============================

    SizeConstraint getSizeConstraint();
    void setSizeConstraint(SizeConstraint constraint);

    int spacing();
    void setSpacing(int spacing);

    // pseudo-properties ======================
    bool isEnabled();
    void setEnabled(bool enabled);

    // methods =================================

    bool activate();

    // virtual void addItem(QLayoutItem *item) = 0

    void addWidget(WidgetHandle widget);
    Margins contentsMargins();
    Rect contentsRect();
    int count();

    // void getContentsMargins(int *left, int *top, int *right, int *bottom) const
    // virtual int indexOf(const QLayoutItem *layoutItem) const

    int indexOf(WidgetHandle widget);

    // virtual QLayoutItem * itemAt(int index) const = 0

    WidgetHandle menuBar();
    WidgetHandle parentWidget();

    // void removeItem(QLayoutItem *item)
    
    void removeWidget(WidgetHandle widget);

    // virtual QLayoutItem * replaceWidget(QWidget *from, QWidget *to, Qt::FindChildOptions options = Qt::FindChildrenRecursively)

    void setAlignment(WidgetHandle widget, Alignment alignment);
    void setAlignment(Handle layout, Alignment alignment);
    void setContentsMargins(Margins margins);
    void setContentsMargins(int left, int top, int right, int bottom);
    void setMenuBar(WidgetHandle widget);

    // virtual QLayoutItem * takeAt(int index) = 0

    void unsetContentsMargins();
    void update();

    // no setsignalmask because abstract
}

// no create because abstract
