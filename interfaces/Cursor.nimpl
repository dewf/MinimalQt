module Cursor;

import Pixmap;
import Enums;
import Screen;
import Common;
import Point2;

@nodispose
opaque Handle {

    // QBitmap bitmap() const

    Point2.Owned hotSpot();

    // QBitmap mask() const

    Pixmap.Owned pixmap();
    void setShape(CursorShape shape);
    CursorShape shape();
}
opaque Owned extends Handle;

// ctors =======================

Owned create();
Owned create(CursorShape shape);
Owned create(Pixmap.Handle pixmap, int hotX = -1, int hotY = -1);

// QCursor(const QBitmap &bitmap, const QBitmap &mask, int hotX = -1, int hotY = -1)

Owned create(Handle other);

// static methods ==============

Point2.Owned pos();
Point2.Owned pos(Screen.Handle screen);
void setPos(int x, int y);
void setPos(Screen.Handle screen, int x, int y);
void setPos(Point2.Handle p);
void setPos(Screen.Handle screen, Point2.Handle p);
