module CalendarWidget;

import Common;
import Icon;
import Object;
import Widget;
import Date;
import Enums;

namedbits SignalMask extends Widget.SignalMask {
    Activated,
    Clicked,
    CurrentPageChanged,
    SelectionChanged
}

interface SignalHandler extends Widget.SignalHandler {
    void activated(Date.Handle date);
    void clicked(Date.Handle date);
    void currentPageChanged(int year, int month);
    void selectionChanged();
}

enum HorizontalHeaderFormat {
    NoHorizontalHeader,
    SingleLetterDayNames,
    ShortDayNames,
    LongDayNames
}

enum VerticalHeaderFormat {
    NoVerticalHeader,
    ISOWeekNumbers
}

enum SelectionMode {
    NoSelection,
    SingleSelection
}

opaque Handle extends Widget.Handle {
    // properties
    int dateEditAcceptDelay();
    void setDateEditAcceptDelay(int value);

    bool isDateEditEnabled();
    void setDateEditEnabled(bool enabled);

    QDayOfWeek firstDayOfWeek();
    void setFirstDayOfWeek(QDayOfWeek value);

    bool isGridVisible();
    void setGridVisible(bool visible);

    // TextCharFormat headerTextFormat();
    // void setHeaderTextFormat(TextCharFormat format);

    HorizontalHeaderFormat getHorizontalHeaderFormat();
    void setHorizontalHeaderFormat(HorizontalHeaderFormat format);

    Date.Owned maximumDate();
    void setMaximumDate(Date.Handle value);
    void clearMaximumDate();

    Date.Owned minimumDate();
    void setMinimumDate(Date.Handle value);
    void clearMinimumDate();

    int monthShown();
    // read-only

    bool isNavigationBarVisible();
    void setNavigationBarVisible(bool visible);

    Date.Owned selectedDate();
    void setSelectedDate(Date.Handle selected);

    SelectionMode getSelectionMode();
    void setSelectionMode(SelectionMode mode);

    VerticalHeaderFormat getVerticalHeaderFormat();
    void setVerticalHeaderFormat(VerticalHeaderFormat format);

    int yearShown();
    // read-only

    // methods
    // Map<Date, TextCharFormat> dateTextFormat();
    // TextCharFormat dateTextFormat(Date date);
    // void setDateTextFormat(Date date, TextCharFormat format);
    // void setWeekdayTextFormat(QDayOfWeek dayOfWeek, TextCharFormat format);
    // TextCharFormat weekdayTextFormat(QDayOfWeek dayOfWeek);

    // etc
    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler);
