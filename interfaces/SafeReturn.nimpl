module SafeReturn;

import ModelIndex;
import Variant;
import Size2;

@nodispose
opaque ModelIndexReturn {
    void setResult(ModelIndex.Handle value);
}

@nodispose
opaque VariantReturn {
    void setResult(Variant.Handle value);
}

@nodispose
opaque SizeReturn {
    void setResult(Size2.Handle value);
}
