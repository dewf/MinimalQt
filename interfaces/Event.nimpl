module Event;

import Object;
import Common;
import Enums;
import KeySequence;
import Region;
import MimeData;

@nodispose
opaque Handle {
    void accept();

    // (since 6.0) virtual QEvent * clone() const

    void ignore();
    bool isAccepted();
    bool isInputEvent();
    bool isPointerEvent();
    bool isSinglePointEvent();
    void setAccepted(bool accepted);
    bool spontaneous();

    // QEvent::Type type() const
}


// Tier 1 events (inherit from QEvent) ==========================================================================

@nodispose
opaque ResizeEvent extends Handle {
    Size oldSize();
    Size size();
}

@nodispose
opaque HelpEvent extends Handle;

@nodispose
opaque DropEvent extends Handle {
    void acceptProposedAction();
    MouseButtons buttons();
    DropAction dropAction();
    MimeData.ConstHandle mimeData();
    KeyboardModifiers modifiers();
    PointF position();
    DropActions possibleActions();
    DropAction proposedAction();
    void setDropAction(DropAction action);
    Object.Handle source();

    // convenience method =============================
    void acceptDropAction(DropAction action); // will internally call either .acceptProposedAction or .accept() after setting drop action
}

@nodispose
opaque InputEvent extends Handle {

    // const QInputDevice * device() const
    // QInputDevice::DeviceType deviceType() const

    KeyboardModifiers modifiers();
    uint64 timestamp();
}

@nodispose
opaque FocusEvent extends Handle {
    bool gotFocus();
    bool lostFocus();
    FocusReason reason();
}

@nodispose
opaque ShowEvent extends Handle;

@nodispose
opaque PaintEvent extends Handle {
    Rect rect();
    Region.Owned region();
}

@nodispose
opaque DragLeaveEvent extends Handle;


// Tier 2 events (inherit from Tier 1) ==========================================================================

@nodispose
opaque ContextMenuEvent extends InputEvent {
    static {
        enum Reason { Mouse, Keyboard, Other }
    }
    Point globalPos();
    int globalX();
    int globalY();
    Point pos();
    Reason getReason();
    int x();
    int y();
}

@nodispose
opaque DragMoveEvent extends DropEvent {
    void accept(Rect rectangle);
    
    @shadows
    void accept();

    Rect answerRect();
    void ignore(Rect rectangle);

    @shadows
    void ignore();
}

@nodispose
opaque KeyEvent extends InputEvent {
    int count();
    bool isAutoRepeat();
    int key();

    // QKeyCombination keyCombination() const

    bool matches(KeySequence.StandardKey key);

    @shadows
    KeyboardModifiers modifiers();
    
    uint32 nativeModifiers();
    uint32 nativeScanCode();
    uint32 nativeVirtualKey();
    string text();
}

@nodispose
opaque PointerEvent extends InputEvent;
// TODO, looks obnoxious and proliferative!


// Tier 3 events (inherit from Tier 2) ==========================================================================

@nodispose
opaque DragEnterEvent extends DragMoveEvent;
// no methods

@nodispose
opaque SinglePointEvent extends PointerEvent {
    MouseButton button();
    MouseButtons buttons();
    Object.Handle exclusivePointGrabber();
    PointF globalPosition();
    PointF position();
    PointF scenePosition();
    void setExclusivePointGrabber(Object.Handle exclusiveGrabber);
}


// Tier 4 events (inherit from Tier 3) ==========================================================================

@nodispose
opaque EnterEvent extends SinglePointEvent;

@nodispose
opaque MouseEvent extends SinglePointEvent {
    MouseEventFlags flags_();
}

@nodispose
opaque WheelEvent extends SinglePointEvent {
    Point angleDelta();
    bool inverted();
    ScrollPhase phase();
    Point pixelDelta();
}

// Tier 5 events (inherit from Tier 4) ==========================================================================
// Tier 6 events (inherit from Tier 5) ==========================================================================
