module ComboBox;

import Object;
import Common;
import Enums;
import Widget;
import Variant;
import AbstractItemModel;
import Icon;

namedbits SignalMask extends Widget.SignalMask {
    Activated,
    CurrentIndexChanged,
    CurrentTextChanged,
    EditTextChanged,
    Highlighted,
    TextActivated,
    TextHighlighted
}

interface SignalHandler extends Widget.SignalHandler {
    void activated(int index);
    void currentIndexChanged(int index);
    void currentTextChanged(string text);
    void editTextChanged(string text);
    void highlighted(int index);
    void textActivated(string text);
    void textHighlighted(string text);
}

enum InsertPolicy {
    NoInsert,
    InsertAtTop,
    InsertAtCurrent,
    InsertAtBottom,
    InsertAfterCurrent,
    InsertBeforeCurrent,
    InsertAlphabetically
}

enum SizeAdjustPolicy {
    AdjustToContents,
    AdjustToContentsOnFirstShow,
    AdjustToMinimumContentsLengthWithIcon
}

opaque Handle extends Widget.Handle {
    // properties ========================
    int count();
    // read-only

    Variant.Owned currentData();
    Variant.Owned currentData(ItemDataRole role);
    // read-only

    int currentIndex();
    void setCurrentIndex(int index);

    string currentText();
    void setCurrentText(string text);

    bool duplicatesEnabled();
    void setDuplicatesEnabled(bool enabled);

    bool isEditable();
    void setEditable(bool editable);
    
    bool hasFrame();
    void setFrame(bool hasFrame);

    Size iconSize();
    void setIconSize(Size size);

    InsertPolicy getInsertPolicy();
    void setInsertPolicy(InsertPolicy policy);

    int maxCount();
    void setMaxCount(int count);

    int maxVisibleItems();
    void setMaxVisibleItems(int count);

    int minimumContentsLength();
    void setMinimumContentsLength(int length);
    
    int modelColumn();
    void setModelColumn(int column);

    string placeholderText();
    void setPlaceholderText(string text);

    SizeAdjustPolicy getSizeAdjustPolicy();
    void setSizeAdjustPolicy(SizeAdjustPolicy policy);

    // methods =============================
    void clear();
    void addItem(string text, Variant.Handle userData);
    void addItem(Icon.Handle icon, string text, Variant.Handle userData);
    void addItems(Array<string> texts);
    void setModel(AbstractItemModel.Handle model);

    // etc
    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler);
Handle downcastFrom(Widget.Handle widget);
