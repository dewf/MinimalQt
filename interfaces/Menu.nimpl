module Menu;

import Object;
import Common;
import Widget;
import Action;
import Icon;

namedbits SignalMask extends Widget.SignalMask {
    AboutToHide,
    AboutToShow,
    Hovered,
    Triggered
}

interface SignalHandler extends Widget.SignalHandler {
    void aboutToHide();
    void aboutToShow();
    void hovered(Action.Handle action);
    void triggered(Action.Handle action);
}

opaque Handle extends Widget.Handle {
    // properties ==============================
    Icon.Owned getIcon();
    void setIcon(Icon.Handle icon);

    bool separatorsCollasible();
    void setSeparatorsCollapsible(bool state);

    bool isTearOffEnabled();
    void setTearOffEnabled(bool state);

    string title();
    void setTitle(string title);

    bool toolTipsVisible();
    void setToolTipsVisible(bool visible);

    // methods =================================
    void clear();
    Action.Handle addSeparator(Action.SignalHandler handler);
    void popup(Point p);

    // signalmask ==============================
    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler);
