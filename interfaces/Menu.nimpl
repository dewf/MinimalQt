module Menu;

import Object;
import Common;
import Point;
import Widget;
import Action;
import Icon;

interface SignalHandler extends Widget.SignalHandler {
    void aboutToHide();
    void aboutToShow();
    void hovered(Action.Handle action);
    void triggered(Action.Handle action);
}

opaque Handle extends Widget.Handle {
    Action.Handle actionAt(Point.Handle pt);
    Rect actionGeometry(Action.Handle act);
    Action.Handle activeAction();
    Action.Handle addMenu(Menu.Handle menu);
    Menu.Handle addMenu(string title);
    Menu.Handle addMenu(Icon.Handle icon, string title);
    Action.Handle addSection(string text);
    Action.Handle addSection(Icon.Handle icon, string text);
    Action.Handle addSeparator();
    void clear();
    Action.Handle defaultAction();
    Action.Handle exec();
    Action.Handle exec(Point.Handle p, Action.Handle action = null);
    void hideTearOffMenu();
    Icon.Owned icon();
    Action.Handle insertMenu(Action.Handle before, Menu.Handle menu);
    Action.Handle insertSection(Action.Handle before, string text);
    Action.Handle insertSection(Action.Handle before, Icon.Handle icon, string text);
    Action.Handle insertSeparator(Action.Handle before);
    bool isEmpty();
    bool isTearOffEnabled();
    bool isTearOffMenuVisible();
    Action.Handle menuAction();
    void popup(Point.Handle p, Action.Handle atAction = null);
    bool separatorsCollapsible();
    void setActiveAction(Action.Handle act);

    // MACOS ONLY
    void setAsDockMenu();

    void setDefaultAction(Action.Handle act);
    void setIcon(Icon.Handle icon);
    void setSeparatorsCollapsible(bool collapse);
    void setTearOffEnabled(bool enabled);
    void setTitle(string title);
    void setToolTipsVisible(bool visible);
    void showTearOffMenu(Point.Handle pos);
    void showTearOffMenu();
    string title();

    // NSMenu * toNSMenu()

    bool toolTipsVisible();

    // signals =================================
    SignalConnection connect_AboutToHide(SignalHandler handler);
    SignalConnection connect_AboutToShow(SignalHandler handler);
    SignalConnection connect_Hovered(SignalHandler handler);
    SignalConnection connect_Triggered(SignalHandler handler);
}

Handle create(Widget.Handle parent = null);
Handle create(string title, Widget.Handle parent = null);

// static methods:

Action.Handle exec(Array<Action.Handle> actions, Point.Handle pos, Action.Handle at = null, Widget.Handle parent = null);
Handle menuInAction(Action.Handle action);
