module Menu;

import Object;
import Common;
import Widget;
import Action;
import Icon;

interface SignalHandler extends Widget.SignalHandler {
    void aboutToHide();
    void aboutToShow();
    void hovered(Action.Handle action);
    void triggered(Action.Handle action);
}

opaque Handle extends Widget.Handle {
    // properties ==============================

    Icon.Owned getIcon();
    void setIcon(Icon.Handle icon);

    bool separatorsCollasible();
    void setSeparatorsCollapsible(bool state);

    bool isTearOffEnabled();
    void setTearOffEnabled(bool state);

    string title();
    void setTitle(string title);

    bool toolTipsVisible();
    void setToolTipsVisible(bool visible);

    // methods =================================

    Action.Handle actionAt(Point pos);
    Rect actionGeometry(Action.Handle act);
    Action.Handle activeAction();
    Action.Handle addMenu(Handle menu);
    Handle addMenu(string title);
    Handle addMenu(Icon.Handle icon, string title);
    Action.Handle addSection(string text, Option<Icon.Handle> icon);
    Action.Handle addSeparator();
    void clear();
    Action.Handle defaultAction(); // I believe this must already be known to client side ...
    Action.Handle exec();
    Action.Handle exec(Point p, Option<Action.Handle> action);
    void hideTearOffMenu();
    Action.Handle insertMenu(Action.Handle before, Handle menu);
    Action.Handle insertSection(Action.Handle before, string text, Option<Icon.Handle> icon);
    Action.Handle insertSeparator(Action.Handle before);
    bool isEmpty();
    bool isTearOffMenuVisible();
    Action.Handle menuAction();     // not sure how this one works, could it be null?
    void popup(Point p, Option<Action.Handle> atAction);
    void setActiveAction(Action.Handle act);
    void setAsDockMenu();
    void setDefaultAction(Action.Handle act);
    void showTearOffMenu(Option<Point> pos);

    // signals =================================
    SignalConnection connect_AboutToHide(SignalHandler handler);
    SignalConnection connect_AboutToShow(SignalHandler handler);
    SignalConnection connect_Hovered(SignalHandler handler);
    SignalConnection connect_Triggered(SignalHandler handler);
}

Handle create(Option<Widget.Handle> parent);
Handle create(string title, Option<Widget.Handle> parent);

// static methods:
Action.Handle exec(Array<Action.Handle> actions, Point pos, Option<Action.Handle> at, Option<Widget.Handle> parent);
Handle menuInAction(Action.Handle action);
