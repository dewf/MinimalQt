module Object;

opaque SignalConnection; // contains a MetaObject::Connection

interface SignalHandler {
    // internal use (always on)
    // void destroyedByQt();

    void destroyed(Handle obj);
    void objectNameChanged(string objectName);
}

@nodispose
opaque Handle {
    // properties =======================
    string objectName();
    void setObjectName(string name);

    // methods ==========================
    void setParent(Handle parent);
    void dumpObjectTree();

    SignalConnection connect_Destroyed(SignalHandler handler);
    SignalConnection connect_ObjectNameChanged(SignalHandler handler);
}

// no create() because abstract

// static methods:
void disconnect(SignalConnection connection);
