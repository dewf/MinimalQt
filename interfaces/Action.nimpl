module Action;

import Object;
import KeySequence;
import Icon;
import Enums;
import Font;

namedbits SignalMask extends Object.SignalMask {
    Changed,
    CheckableChanged,
    EnabledChanged,
    Hovered,
    Toggled,
    Triggered,
    VisibleChanged
}

interface SignalHandler extends Object.SignalHandler {
    void changed();
    void checkableChanged(bool checkable);
    void enabledChanged(bool enabled);
    void hovered();
    void toggled(bool checked_);
    void triggered(bool checked_);
    void visibleChanged();
}

enum MenuRole { 
    NoRole = 0, 
    TextHeuristicRole, 
    ApplicationSpecificRole, 
    AboutQtRole, 
    AboutRole, 
    PreferencesRole, 
    QuitRole
}

enum Priority {
    LowPriority = 0, 
    NormalPriority = 128,
    HighPriority = 256
}

opaque Handle extends Object.Handle {
    // properties
    bool autoRepeat();
    void setAutoRepeat(bool state);
    
    bool isCheckable();
    void setCheckable(bool checkable);

    bool isChecked();
    void setChecked(bool checked_);

    bool isEnabled();
    void setEnabled(bool enabled);

    Font.Owned getFont();              // CHANGEME: altered because of collision with Icon type when rendering push/pop stuff, codegen needs fixing
    void setFont(Font.Handle font);

    Icon.Owned getIcon();              // CHANGEME: see above
    void setIcon(Icon.Handle icon);

    string iconText();
    void setIconText(string text);

    bool isIconVisibleInMenu();
    void setIconVisibleInMenu(bool visible);

    MenuRole menuRole();
    void setMenuRole(MenuRole role);

    Priority priority();
    void setPriority(Priority priority);

    KeySequence.Owned shortcut();
    void setShortcut(KeySequence.Deferred shortcut);

    Enums.ShortcutContext shortcutContext();
    void setShortcutContext(Enums.ShortcutContext context);

    bool isShortcutVisibleInContextMenu();
    void setShortcutVisibleInContextMenu(bool visible);

    string statusTip();
    void setStatusTip(string tip);

    string text();
    void setText(string text);

    string toolTip();
    void setToolTip(string tip);

    bool isVisible();
    void setVisible(bool visible);

    string whatsThis();
    void setWhatsThis(string text);

    // methods:
    void setSeparator(bool state);

    // signal mask:
    void setSignalMask(SignalMask mask);
}

Handle create(Object.Handle owner, SignalHandler handler);
