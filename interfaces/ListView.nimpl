module ListView;

import Object;
import Common;
import Enums;
import Icon;
import AbstractListModel;
import ModelIndex;
import AbstractItemView;
import Widget;

namedbits SignalMask extends AbstractItemView.SignalMask {
    IndexesMoved
}

interface SignalHandler extends AbstractItemView.SignalHandler {
    void indexesMoved(Array<ModelIndex.Handle> indexes);
}

enum Movement {
    Static,
    Free,
    Snap
}

enum Flow {
    LeftToRight,
    TopToBottom
}

enum ResizeMode {
    Fixed,
    Adjust
}

enum LayoutMode {
    SinglePass,
    Batched
}

enum ViewMode {
    ListMode,
    IconMode
}

opaque Handle extends AbstractItemView.Handle {
    // properties =============

    int batchSize();
    void setBatchSize(int size);

    Flow getFlow();
    void setFlow(Flow flow);

    Size gridSize();
    void setGridSize(Size size);

    Alignment itemAlignment();
    void setItemAlignment(Alignment align);

    LayoutMode getLayoutMode();
    void setLayoutMode(LayoutMode mode);

    int modelColumn();
    void setModelColumn(int column);

    Movement getMovement();
    void setMovement(Movement value);

    ResizeMode getResizeMode();
    void setResizeMode(ResizeMode mode);

    bool isSelectionRectVisible();
    void setSelectionRectVisible(bool visible);
    
    int spacing();
    void setSpacing(int spacing);

    bool uniformItemSizes();
    void setUniformItemSizes(bool state);

    ViewMode getViewMode();
    void setViewMode(ViewMode mode);

    bool wordWrap();
    void setWordWrap(bool state);

    bool isWrapping();
    void setWrapping(bool wrapping);

    // methods ================

    void clearPropertyFlags();
    bool isRowHidden(int row);
    void setRowHidden(int row, bool hide);

    // etc ====================
    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler, Option<Widget.Handle> parent);
