module Url;

@nodispose
opaque Handle {
    string toAbsoluteInternal();
}
opaque Owned extends Handle;

Owned createFromAbsolute(string absoluteUrl);

// list ===============================

opaque List {
    Array<Handle> items();
    Array<string> itemsAbsolute();
}

List createFromAbsoluteList(Array<string> absoluteUrls);
