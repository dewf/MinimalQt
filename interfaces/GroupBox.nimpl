module GroupBox;

import Object;
import Common;
import Icon;
import Enums;
import Widget;

interface SignalHandler extends Widget.SignalHandler {
    void clicked(bool checked_);
    void toggled(bool state);
}

opaque Handle extends Widget.Handle {
    // properties:
    Alignment getAlignment();
    void setAlignment(Alignment align);

    bool isCheckable();
    void setCheckable(bool state);

    bool isChecked();
    void setChecked(bool state);

    bool isFlat();
    void setFlat(bool state);

    string title();
    void setTitle(string title);

    // signals ============================
    SignalConnection connect_Clicked(SignalHandler handler);
    SignalConnection connect_Toggled(SignalHandler handler);
}

Handle create(Option<Widget.Handle> parent);
Handle create(string title, Option<Widget.Handle> parent);
