module MenuBar;

import Object;
import Common;
import Enums;
import Icon;
import Widget;
import Menu;
import Action;

interface SignalHandler extends Widget.SignalHandler {
    void hovered(Action.Handle action);
    void triggered(Action.Handle action);
}

opaque Handle extends Widget.Handle {
    // properties ===================

    bool isDefaultUp();
    void setDefaultUp(bool state);

    bool isNativeMenuBar();
    void setNativeMenuBar(bool state);

    // methods ======================

    Action.Handle actionAt(Point pt);
    Rect actionGeometry(Action.Handle act);
    Action.Handle activeAction();
    Action.Handle addMenu(Menu.Handle menu, Action.SignalHandler actionHandler);
    Menu.Handle addMenu(string title, Menu.SignalHandler menuHandler);
    Menu.Handle addMenu(Icon.Handle icon, string title, Menu.SignalHandler menuHandler);
    Action.Handle addSeparator(Action.SignalHandler actionHandler);
    void clear();
    Widget.Handle cornerWidget(Option<Corner> corner);
    Action.Handle insertMenu(Action.Handle before, Menu.Handle menu, Action.SignalHandler actionHandler);
    Action.Handle insertSeparator(Action.Handle before, Action.SignalHandler actionHandler);
    void setActiveAction(Action.Handle act);
    void setCornerWidget(Widget.Handle widget, Option<Corner> corner);

    // signals ======================
    SignalConnection connect_Hovered(SignalHandler handler);
    SignalConnection connect_Triggered(SignalHandler handler);
}

Handle create(Option<Widget.Handle> parent);
