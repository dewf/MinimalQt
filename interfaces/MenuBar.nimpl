module MenuBar;

import Object;
import Common;
import Icon;
import Widget;
import Menu;
import Action;

namedbits SignalMask extends Widget.SignalMask {
    Hovered,
    Triggered
}

interface SignalHandler extends Widget.SignalHandler {
    void hovered(Action.Handle action);
    void triggered(Action.Handle action);
}

opaque Handle extends Widget.Handle {
    bool isDefaultUp();
    void setDefaultUp(bool state);

    bool isNativeMenuBar();
    void setNativeMenuBar(bool state);

    void clear();
    Action.Handle addMenu(Menu.Handle menu, Action.SignalHandler handler); // add existing menu, DOESN'T take ownership

    Menu.Handle addMenu(string title, Menu.SignalHandler handler);                   // creates and adds a new menu, IS owned
    Menu.Handle addMenu(Icon.Handle icon, string title, Menu.SignalHandler handler); // same

    Action.Handle addSeparator(Action.SignalHandler handler); // does this work outside of Motif?

    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler);
