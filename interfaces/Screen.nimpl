module Screen;

import Object;
import Common;
import Point;
import Size2;
import Enums;
import Pixmap;
import Transform;

interface SignalHandler extends Object.SignalHandler {
    void availableGeometryChanged(Rect geometry);
    void geometryChanged(Rect geometry);
    void logicalDotsPerInchChanged(double dpi);
    void orientationChanged(ScreenOrientation orientation);
    void physicalDotsPerInchChanged(double dpi);
    void physicalSizeChanged(SizeF size);
    void primaryOrientationChanged(ScreenOrientation orientation);
    void refreshRateChanged(double refreshRate);
    void virtualGeometryChanged(Rect rect);
}

@nodispose
opaque Handle extends Object.Handle {
    int angleBetween(ScreenOrientation a, ScreenOrientation b);
    Rect availableGeometry();
    Size2.Owned availableSize();
    Rect availableVirtualGeometry();
    Size2.Owned availableVirtualSize();
    int depth();
    double devicePixelRatio();
    Rect geometry();
    Pixmap.Owned grabWindow(size_t window = 0, int x = 0, int y = 0, int width = -1, int height = -1);

    // QPlatformScreen * handle() const

    bool isLandscape(ScreenOrientation o);
    bool isPortrait(ScreenOrientation o);
    double logicalDotsPerInch();
    double logicalDotsPerInchX();
    double logicalDotsPerInchY();
    string manufacturer();
    Rect mapBetween(ScreenOrientation a, ScreenOrientation b, Rect rect);
    string model();
    string name();

    // QNativeInterface * nativeInterface() const

    ScreenOrientation nativeOrientation();
    ScreenOrientation orientation();
    double physicalDotsPerInch();
    double physicalDotsPerInchX();
    double physicalDotsPerInchY();
    SizeF physicalSize();
    ScreenOrientation primaryOrientation();
    double refreshRate();
    string serialNumber();
    Size2.Owned size();
    Transform.Owned transformBetween(ScreenOrientation a, ScreenOrientation b, Rect target);
    Rect virtualGeometry();
    Handle virtualSiblingAt(Point.Handle point);
    Array<Handle> virtualSiblings();
    Size2.Owned virtualSize();

    SignalConnection connect_AvailableGeometryChanged(SignalHandler handler);
    SignalConnection connect_GeometryChanged(SignalHandler handler);
    SignalConnection connect_LogicalDotsPerInchChanged(SignalHandler handler);
    SignalConnection connect_OrientationChanged(SignalHandler handler);
    SignalConnection connect_PhysicalDotsPerInchChanged(SignalHandler handler);
    SignalConnection connect_PhysicalSizeChanged(SignalHandler handler);
    SignalConnection connect_PrimaryOrientationChanged(SignalHandler handler);
    SignalConnection connect_RefreshRateChanged(SignalHandler handler);
    SignalConnection connect_VirtualGeometryChanged(SignalHandler handler);
}
