module StatusBar;

import Object;
import Widget;

interface SignalHandler extends Widget.SignalHandler {
    void messageChanged(string message);
}

opaque Handle extends Widget.Handle {
    void addPermanentWidget(Widget.Handle widget, int stretch = 0);
    void addWidget(Widget.Handle widget, int stretch = 0);
    string currentMessage();
    int insertPermanentWidget(int index, Widget.Handle widget, int stretch = 0);
    int insertWidget(int index, Widget.Handle widget, int stretch = 0);
    bool isSizeGripEnabled();
    void removeWidget(Widget.Handle widget);
    void setSizeGripEnabled(bool enable);
    void clearMessage();
    void showMessage(string message, int timeout = 0);

    // signals ============================
    SignalConnection connect_MessageChanged(SignalHandler handler);
}

Handle create(Widget.Handle parent = null);
