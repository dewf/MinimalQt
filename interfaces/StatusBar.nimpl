module StatusBar;

import Object;
import Common;
import Icon;
import Widget;

interface SignalHandler extends Widget.SignalHandler {
    void messageChanged(string message);
}

opaque Handle extends Widget.Handle {
    bool isSizeGripEnabled();               // just testing something ...
    void setSizeGripEnabled(bool enabled);
    
    void clearMessage();
    void showMessage(string message, int timeout);

    // signals ============================
    SignalConnection connect_MessageChanged(SignalHandler handler);
}

Handle create();
