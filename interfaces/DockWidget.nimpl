module DockWidget;

import Object;
import Widget;
import Enums;
import Action;

flags DockWidgetFeatures {
    DockWidgetClosable    = 0x01,
    DockWidgetMovable     = 0x02,
    DockWidgetFloatable   = 0x04,
    DockWidgetVerticalTitleBar = 0x08,

    DockWidgetFeatureMask = 0x0f,
    NoDockWidgetFeatures  = 0x00,

    Reserved              = 0xff
}

interface SignalHandler extends Widget.SignalHandler {
    void allowedAreasChanged(DockWidgetAreas allowedAreas);
    void dockLocationChanged(DockWidgetArea area);
    void featuresChanged(DockWidgetFeatures features);
    void topLevelChanged(bool topLevel);
    void visibilityChanged(bool visible);
}

@nodispose
opaque Handle extends Widget.Handle {
    DockWidgetAreas allowedAreas();
    DockWidgetFeatures features();
    bool isAreaAllowed(DockWidgetArea area);
    bool isFloating();
    void setAllowedAreas(DockWidgetAreas areas);
    void setFeatures(DockWidgetFeatures features);
    void setFloating(bool floating);
    void setTitleBarWidget(Widget.Handle widget);
    void setWidget(Widget.Handle widget);
    Widget.Handle titleBarWidget();
    Action.Handle toggleViewAction();
    Widget.Handle widget();

    // signals ============================
    SignalConnection connect_AllowedAreasChanged(SignalHandler handler);
    SignalConnection connect_DockLocationChanged(SignalHandler handler);
    SignalConnection connect_FeaturesChanged(SignalHandler handler);
    SignalConnection connect_TopLevelChanged(SignalHandler handler);
    SignalConnection connect_VisibilityChanged(SignalHandler handler);
}

Handle create(Widget.Handle parent = null, WindowFlags flags_ = 0);
Handle create(string title, Widget.Handle parent = null, WindowFlags flags_ = 0);
