module BoxLayout;

import Common;
import Widget;
import Layout;
import Enums;
import Object;

interface SignalHandler extends Layout.SignalHandler {
    // none of our own
}

enum Direction {
    LeftToRight,
    RightToLeft,
    TopToBottom,
    BottomToTop
}

opaque Handle extends Layout.Handle {
    static {
        options AddWidgetOptions {
            int stretch;
            Alignment align;
        }
        options AddLayoutOptions {
            int stretch;
        }
    }
    void setDirection(Direction dir);

    // item adding:
    void addSpacing(int size);
    void addStretch(int stretch);
    void addWidget(Widget.Handle widget, AddWidgetOptions opts);
    void addLayout(Layout.Handle layout, AddLayoutOptions opts);
}

Handle create(Direction dir);
Handle createNoHandler(Direction dir);
