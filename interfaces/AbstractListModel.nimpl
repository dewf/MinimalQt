module AbstractListModel;

import Object;
import Enums;
import AbstractItemModel;
import Variant;
import ModelIndex;
import PersistentModelIndex;

namedbits SignalMask extends AbstractItemModel.SignalMask {
    // none extra
}

interface SignalHandler extends AbstractItemModel.SignalHandler {
    // none extra
}

@nodispose
opaque Handle extends AbstractItemModel.Handle;

// subclass (implementation) stuff ==========================================================

flags ItemFlags {
    NoItemFlags = 0,
    ItemIsSelectable = 1,
    ItemIsEditable = 2,
    ItemIsDragEnabled = 4,
    ItemIsDropEnabled = 8,
    ItemIsUserCheckable = 16,
    ItemIsEnabled = 32,
    ItemIsAutoTristate = 64,
    ItemNeverHasChildren = 128,
    ItemIsUserTristate = 256
}

namedbits ImplementedMethodMask { // TODO: inherit from AbstractItemModel DelegatedMethodMask?
    // required, so not in mask:
    // RowCount
    // Data

    // optional:
    HeaderData,
    Flags,
    SetData,
    ColumnCount    // from the docs it seems like AbstractListModel is not supposed to do multi-column stuff, but why not? seems to work (with a tree view)
}

interface ImplementationMethods {
    int rowCount(ModelIndex.Handle parent);
    Variant.Owned data(ModelIndex.Handle index, ItemDataRole role);
    
    // "optional" (we still have to implement, but only active if mask flag is set)
    Variant.Owned headerData(int section, Orientation orientation, ItemDataRole role);
    ItemFlags getFlags(ModelIndex.Handle index, ItemFlags baseFlags);
    bool setData(ModelIndex.Handle index, Variant.Handle value, ItemDataRole role);
    int columnCount(ModelIndex.Handle parent);
}

opaque Interior extends Handle {
    // "interior" methods, to call as if we're the C++ subclass:

    // signal emission
    void emitDataChanged(ModelIndex.Handle topLeft, ModelIndex.Handle bottomRight, Array<ItemDataRole> roles);
    void emitHeaderDataChanged(Orientation orientation, int first, int last);

    // for access to protected stuff from MethodDelegate
    void beginInsertRows(ModelIndex.Handle parent, int first, int last);
    void endInsertRows();

    void beginRemoveRows(ModelIndex.Handle parent, int first, int last);
    void endRemoveRows();

    void beginResetModel();
    void endResetModel();

    // etc:
    void setSignalMask(SignalMask mask); // here because Handle is abstract!
}

Interior createImplementation(SignalHandler handler, ImplementationMethods methods, ImplementedMethodMask mask);
