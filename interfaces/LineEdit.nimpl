module LineEdit;

import Object;
import Widget;
import Common;
import Icon;
import Enums;
import Action;
import Menu;

interface SignalHandler extends Widget.SignalHandler {
    void cursorPositionChanged(int oldPos, int newPos);
    void editingFinished();
    void inputRejected();
    void returnPressed();
    void selectionChanged();
    void textChanged(string text);
    void textEdited(string text);
}

enum EchoMode { Normal, NoEcho, Password, PasswordEchoOnEdit }

enum ActionPosition {
    LeadingPosition,
    TrailingPosition
}

opaque Handle extends Widget.Handle {
    // properties ==================================
    bool hasAcceptableInput();
    // read-only

    Alignment getAlignment();
    void setAlignment(Alignment align);

    bool isClearButtonEnabled();
    void setClearButtonEnabled(bool enabled);

    CursorMoveStyle getCursorMoveStyle();
    void setCursorMoveStyle(CursorMoveStyle style);

    int cursorPosition();
    void setCursorPosition(int pos);

    string displayText();
    // read-only

    bool dragEnabled();
    void setDragEnabled(bool enabled);

    EchoMode getEchoMode();
    void setEchoMode(EchoMode mode);

    bool hasFrame();
    void setFrame(bool enabled);

    bool hasSelectedText();
    // read-only

    string inputMask();
    void setInputMask(string mask);

    int maxLength();
    void setMaxLength(int length);

    // not sure about these two, might not need the setter? read docs
    bool isModified();
    void setModified(bool modified);

    string placeholderText();
    void setPlaceholderText(string text);

    bool isReadOnly();
    void setReadOnly(bool value);

    bool isRedoAvailable();
    // read-only

    string selectedText();
    // read-only

    string text();
    void setText(string text);

    bool isUndoAvailable();
    // read-only

    // methods =================================

    void addAction(Action.Handle action, ActionPosition position);
    void addAction(Icon.Handle icon, ActionPosition position);
    void backspace();

    // QCompleter * completer() const

    Menu.Handle createStandardContextMenu(Menu.SignalHandler handler); // what happens if this is called more than once?
    void cursorBackward(bool mark, Option<int> steps);
    void cursorForward(bool mark, Option<int> steps);
    int cursorPositionAt(Point pos);
    void cursorWordBackward(bool mark);
    void cursorWordForward(bool mark);
    void del();
    void deselect();
    void end(bool mark);
    void home(bool mark);
    void insert(string newText);
    int selectionEnd();
    int selectionLength();
    int selectionStart();

    // void setCompleter(QCompleter *c)
    
    void setSelection(int start, int length);
    void setTextMargins(Margins margins);
    void setTextMargins(int left, int top, int right, int bottom);

    // void setValidator(const QValidator *v)

    Margins textMargins();

    // const QValidator * validator() const

    // slots ===================================
    
    void clear();
    void copy();
    void cut();
    void paste();
    void redo();
    void selectAll();
    void undo();

    // signals =================================
    SignalConnection connect_CursorPositionChanged(SignalHandler handler);
    SignalConnection connect_EditingFinished(SignalHandler handler);
    SignalConnection connect_InputRejected(SignalHandler handler);
    SignalConnection connect_ReturnPressed(SignalHandler handler);
    SignalConnection connect_SelectionChanged(SignalHandler handler);
    SignalConnection connect_TextChanged(SignalHandler handler);
    SignalConnection connect_TextEdited(SignalHandler handler);
}

Handle create(Option<Widget.Handle> parent);
Handle create(string contents, Option<Widget.Handle> parent);
