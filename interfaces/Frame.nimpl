module Frame;

import Object;
import Common;
import Icon;
import Widget;

namedbits SignalMask extends Widget.SignalMask {
    // none of our own
}

interface SignalHandler extends Widget.SignalHandler {
    // (none)
}

enum Shape {
    NoFrame = 0,
    Box = 0x1,
    Panel = 0x2,
    StyledPanel = 0x6,
    HLine = 0x4,
    VLine = 0x5,
    WinPanel = 0x3
}

enum Shadow {
    Plain = 0x10,
    Raised = 0x20,
    Sunken = 0x30
}

// enum Style
// Qt's frame style is just a bitwise-OR between shape and shadow

opaque Handle extends Widget.Handle {
    // properties:
    Rect frameRect();
    void setFrameRect(Rect rect);

    Shadow frameShadow();
    void setFrameShadow(Shadow shadow);

    Shape frameShape();
    void setFrameShape(Shape shape);
    
    int frameWidth();
    // read-only

    int lineWidth();
    void setLineWidth(int width);

    int midLineWidth();
    void setMidLineWidth(int width);

    // methods:
    void setFrameStyle(Shape shape, Shadow shadow);

    // etc:
    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler);
