module GridLayout;

import Object;
import Common;
import Widget;
import Layout;
import Enums;

interface SignalHandler extends Layout.SignalHandler {
    // none of our own
}

opaque Handle extends Layout.Handle {
    static {
        struct ItemPositionResult {
            int row;
            int column;
            int rowSpan;
            int columnSpan;
        }
    }

    // properties:
    int horizontalSpacing();
    void setHorizontalSpacing(int value);

    int verticalSpacing();
    void setVerticalSpacing(int value);

    // methods:
    // void addItem(QLayoutItem *item, int row, int column, int rowSpan = 1, int columnSpan = 1, Qt::Alignment alignment = Qt::Alignment());
    // TODO: need to figure out layout items
    
    void addLayout(Layout.Handle layout, int row, int column, Alignment alignment = 0);
    void addLayout(Layout.Handle layout, int row, int column, int rowSpan, int columnSpan, Alignment alignment = 0);
    void addWidget(Widget.Handle widget, int row, int column, Alignment alignment = 0);
    void addWidget(Widget.Handle widget, int fromRow, int fromColumn, int rowSpan, int columnSpan, Alignment alignment = 0);
    Rect cellRect(int row, int column);
    int columnCount();
    int columnMinimumWidth(int column);
    int columnStretch(int column);
    ItemPositionResult getItemPosition(int index);

    // QLayoutItem * itemAtPosition(int row, int column);
    // TODO: need to figure out layout items, because of multiple inheritance issues

    Corner originCorner();
    int rowCount();
    int rowMinimumHeight(int row);
    int rowStretch(int row);
    void setColumnMinimumWidth(int column, int minSize);
    void setColumnStretch(int column, int stretch);
    void setOriginCorner(Corner corner);
    void setRowMinimumHeight(int row, int minSize);
    void setRowStretch(int row, int stretch);

    // no extra signals
}

Handle create(Option<Widget.Handle> parent);
