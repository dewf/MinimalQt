module AbstractItemView;

import Object;
import Common;
import Size;
import Point;
import Rect;
import Enums;
import Icon;
import AbstractScrollArea;
import AbstractItemModel;
import ModelIndex;
import AbstractItemDelegate;
import ItemSelectionModel;
import Widget;

interface SignalHandler extends AbstractScrollArea.SignalHandler {
    void activated(ModelIndex.Handle index);
    void clicked(ModelIndex.Handle index);
    void doubleClicked(ModelIndex.Handle index);
    void entered(ModelIndex.Handle index);
    void iconSizeChanged(Size.Handle size);
    void pressed(ModelIndex.Handle index);
    void viewportEntered();
}

enum DragDropMode {
    NoDragDrop,
    DragOnly,
    DropOnly,
    DragDrop,
    InternalMove
}

@withflags(EditTriggers)
enum EditTrigger {
    NoEditTriggers = 0,
    CurrentChanged = 1,
    DoubleClicked = 2,
    SelectedClicked = 4,
    EditKeyPressed = 8,
    AnyKeyPressed = 16,
    AllEditTriggers = 31
}

enum ScrollHint {
    EnsureVisible,
    PositionAtTop,
    PositionAtBottom,
    PositionAtCenter
}

enum ScrollMode {
    ScrollPerItem,
    ScrollPerPixel
}

enum SelectionBehavior {
    SelectItems,
    SelectRows,
    SelectColumns
}

enum SelectionMode {
    NoSelection,
    SingleSelection,
    MultiSelection,
    ExtendedSelection,
    ContiguousSelection
}

@nodispose
opaque Handle extends AbstractScrollArea.Handle {
    bool alternatingRowColors();
    int autoScrollMargin();
    void closePersistentEditor(ModelIndex.Handle index);
    ModelIndex.Owned currentIndex();
    DropAction defaultDropAction();
    DragDropMode getDragDropMode();
    bool dragDropOverwriteMode();
    bool dragEnabled();
    EditTriggers getEditTriggers();
    bool hasAutoScroll();
    ScrollMode horizontalScrollMode();
    Size.Owned iconSize();
    ModelIndex.Owned indexAt(Point.Handle point);
    Widget.Handle indexWidget(ModelIndex.Handle index);
    bool isPersistentEditorOpen(ModelIndex.Handle index);
    AbstractItemDelegate.Handle itemDelegate();
    AbstractItemDelegate.Handle itemDelegateForColumn(int column);
    AbstractItemDelegate.Handle itemDelegateForIndex(ModelIndex.Handle index);
    AbstractItemDelegate.Handle itemDelegateForRow(int row);
    void keyboardSearch(string search);
    AbstractItemModel.Handle model();
    void openPersistentEditor(ModelIndex.Handle index);
    void resetHorizontalScrollMode();
    void resetVerticalScrollMode();
    ModelIndex.Owned rootIndex();
    void scrollTo(ModelIndex.Handle index, ScrollHint hint = EnsureVisible);
    SelectionBehavior getSelectionBehavior();
    SelectionMode getSelectionMode();
    ItemSelectionModel.Handle selectionModel();
    void setAlternatingRowColors(bool enable);
    void setAutoScroll(bool enable);
    void setAutoScrollMargin(int margin);
    void setDefaultDropAction(DropAction dropAction);
    void setDragDropMode(DragDropMode behavior);
    void setDragDropOverwriteMode(bool overwrite);
    void setDragEnabled(bool enable);
    void setDropIndicatorShown(bool enable);
    void setEditTriggers(EditTriggers triggers);
    void setHorizontalScrollMode(ScrollMode mode);
    void setIconSize(Size.Handle size);
    void setIndexWidget(ModelIndex.Handle index, Widget.Handle widget);
    void setItemDelegate(AbstractItemDelegate.Handle delegate_);
    void setItemDelegateForColumn(int column, AbstractItemDelegate.Handle delegate_);
    void setItemDelegateForRow(int row, AbstractItemDelegate.Handle delegate_);
    void setModel(AbstractItemModel.Handle model);
    void setSelectionBehavior(SelectionBehavior behavior);
    void setSelectionMode(SelectionMode mode);
    void setSelectionModel(ItemSelectionModel.Handle selectionModel);
    void setTabKeyNavigation(bool enable);
    void setTextElideMode(TextElideMode mode);
    void setVerticalScrollMode(ScrollMode mode);
    bool showDropIndicator();
    int sizeHintForColumn(int column);
    Size.Owned sizeHintForIndex(ModelIndex.Handle index);
    int sizeHintForRow(int row);
    bool tabKeyNavigation();
    TextElideMode textElideMode();
    ScrollMode verticalScrollMode();
    Rect.Owned visualRect(ModelIndex.Handle index);

    void clearSelection();
    void edit(ModelIndex.Handle index);
    void reset();
    void scrollToBottom();
    void scrollToTop();
    void selectAll();
    void setCurrentIndex(ModelIndex.Handle index);
    void setRootIndex(ModelIndex.Handle index);
    void update(ModelIndex.Handle index);

    // signals ============================
    SignalConnection connect_Activated(SignalHandler handler);
    SignalConnection connect_Clicked(SignalHandler handler);
    SignalConnection connect_DoubleClicked(SignalHandler handler);
    SignalConnection connect_Entered(SignalHandler handler);
    SignalConnection connect_IconSizeChanged(SignalHandler handler);
    SignalConnection connect_Pressed(SignalHandler handler);
    SignalConnection connect_ViewportEntered(SignalHandler handler);
}
