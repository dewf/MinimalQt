module AbstractItemView;

import Object;
import Common;
import Enums;
import Icon;
import AbstractScrollArea;
import AbstractItemModel;
import ModelIndex;
import AbstractItemDelegate;
import ItemSelectionModel;

namedbits SignalMask extends AbstractScrollArea.SignalMask {
    Activated,
    Clicked,
    DoubleClickedBit, // 'Bit' to distinguish from a Qt-defined enum/flag
    Entered,
    IconSizeChanged,
    Pressed,
    ViewportEntered
}

interface SignalHandler extends AbstractScrollArea.SignalHandler {
    void activated(ModelIndex.Handle index);
    void clicked(ModelIndex.Handle index);
    void doubleClicked(ModelIndex.Handle index);
    void entered(ModelIndex.Handle index);
    void iconSizeChanged(Size size);
    void pressed(ModelIndex.Handle index);
    void viewportEntered();
}

enum DragDropMode {
    NoDragDrop,
    DragOnly,
    DropOnly,
    DragDrop,
    InternalMove
}

enum EditTrigger {
    NoEditTriggers = 0,
    CurrentChanged = 1,
    DoubleClicked = 2,
    SelectedClicked = 4,
    EditKeyPressed = 8,
    AnyKeyPressed = 16,
    AllEditTriggers = 31
}

flags EditTriggers {
    NoEditTriggers = 0,
    CurrentChanged = 1,
    DoubleClicked = 2,
    SelectedClicked = 4,
    EditKeyPressed = 8,
    AnyKeyPressed = 16,
    AllEditTriggers = 31
}

enum ScrollMode {
    ScrollPerItem,
    ScrollPerPixel
}

enum SelectionBehavior {
    SelectItems,
    SelectRows,
    SelectColumns
}

enum SelectionMode {
    NoSelection,
    SingleSelection,
    MultiSelection,
    ExtendedSelection,
    ContiguousSelection
}

// used for creating a signal handler on demand, if the selection model isn't already wrapped
delegate ItemSelectionModel.SignalHandler CreateSelectionModelHandlerFunc();

@nodispose
opaque Handle extends AbstractScrollArea.Handle {
    // properties =======================
    bool alternatingRowColors();
    void setAlternatingRowColors(bool state);

    bool hasAutoScroll();
    void setAutoScroll(bool state);

    int autoScrollMargin();
    void setAutoScrollMargin(int margin);

    DropAction defaultDropAction();
    void setDefaultDropAction(DropAction action);

    DragDropMode getDragDropMode();
    void setDragDropMode(DragDropMode mode);

    bool dragDropOverwriteMode();
    void setDragDropOverwriteMode(bool mode);

    bool dragEnabled();
    void setDragEnabled(bool enabled);

    EditTriggers getEditTriggers();
    void setEditTriggers(EditTriggers triggers);
    
    ScrollMode horizontalScrollMode();
    void setHorizontalScrollMode(ScrollMode mode);
    void resetHorizontalScrollMode();

    Size iconSize();
    void setIconSize(Size size);

    SelectionBehavior getSelectionBehavior();
    void setSelectionBehavior(SelectionBehavior behavior);

    SelectionMode getSelectionMode();
    void setSelectionMode(SelectionMode mode);

    bool showDropIndicator();
    void setDropIndicatorShown(bool state);

    bool tabKeyNavigation();
    void setTabKeyNavigation(bool state);

    TextElideMode getTextElideMode();
    void setTextElideMode(TextElideMode mode);

    ScrollMode verticalScrollMode();
    void setVerticalScrollMode(ScrollMode mode);
    void resetVerticalScrollMode();

    // methods ==========================
    void setModel(AbstractItemModel.Handle model);

    void clearSelection();
    void edit(ModelIndex.Handle index);
    void reset();
    void scrollToBottom();
    void scrollToTop();
    void selectAll();
    void setCurrentIndex(ModelIndex.Handle index);
    void setRootIndex(ModelIndex.Handle index);
    void update(ModelIndex.Handle index);

    ItemSelectionModel.Handle selectionModel(CreateSelectionModelHandlerFunc createHandlerFunc);
    // no setter yet

    void setItemDelegate(AbstractItemDelegate.Handle itemDelegate);
    void setItemDelegateForColumn(int column, AbstractItemDelegate.Handle itemDelegate);
    void setItemDelegateForRow(int row, AbstractItemDelegate.Handle itemDelegate);
}
