module ModelIndex;

import Variant;
import Enums;

@nodispose
opaque Handle {
    bool isValid();
    int row();
    int column();

    Variant.Owned data();
    Variant.Owned data(ItemDataRole role);
}

opaque Owned extends Handle {
    SafeReturn getSafeReturn(); // see note below / or in Variant module
}

// really just an addRef'ed version of an existing Owned, but nice to document in the API to prevent mishaps
opaque SafeReturn extends Owned;

Owned create(); // empty/invalid
