module ModelIndex;

import Variant;
import Enums;

fwdopaque AbstractItemModelHandle = AbstractItemModel.Handle;

@nodispose
opaque Handle {
    int column();
    Variant.Owned data();
    Variant.Owned data(ItemDataRole role);
    ItemFlags getFlags();
    size_t internalId(); // is there any real difference between this and internalPointer?
    bool isValid();
    
    AbstractItemModelHandle model();

    // void multiData(...) TODO
    
    Owned parent();
    int row();
    Owned sibling(int row, int column);
    Owned siblingAtColumn(int column);
    Owned siblingAtRow(int row);
}

opaque Owned extends Handle {
    SafeReturn getSafeReturn(); // see note below / or in Variant module
}

// really just an addRef'ed version of an existing Owned, but nice to document in the API to prevent mishaps
opaque SafeReturn extends Owned;

Owned create(); // empty/invalid
