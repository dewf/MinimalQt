module Size;

import Common;
import Enums;
import Margins2;

fwdopaque SizeF_Owned = SizeF.Owned;

@nodispose
opaque Handle {

    int hashCode();

    Owned boundedTo(Handle otherSize);
    Owned expandedTo(Handle otherSize);
    Owned grownBy(Margins2.Handle margins);
    int height();
    bool isEmpty();
    bool isNull();
    bool isValid();

    // int & rheight()
    // int & rwidth()

    void scale(int width, int height, AspectRatioMode mode);
    void scale(Handle size, AspectRatioMode mode);
    Owned scaled(int width, int height, AspectRatioMode mode);
    Owned scaled(Handle s, AspectRatioMode mode);
    void setHeight(int height);
    void setWidth(int width);
    Owned shrunkBy(Margins2.Handle margins);

    // CGSize toCGSize() const

    SizeF_Owned toSizeF();
    void transpose();
    Owned transposed();
    int width();

    // the following return 'this':

    Handle operator_multiplyBy(double factor);
    Handle operator_incrementBy(Handle size);
    Handle operator_decrementBy(Handle size);
    Handle operator_divideBy(double divisor);
}
opaque Owned extends Handle;

Owned create();
Owned create(int width, int height);

// operators ======================================

bool operator_notEqual(Handle lhs, Handle rhs);
Owned operator_mul(Handle size, double factor);

// QSize operator*(qreal factor, const QSize &size)

Owned operator_add(Handle s1, Handle s2);
Owned operator_sub(Handle s1, Handle s2);
Owned operator_div(Handle size, double divisor);

// QDataStream & operator<<(QDataStream &stream, const QSize &size)

bool operator_equal(Handle lhs, Handle rhs);

// QDataStream & operator>>(QDataStream &stream, QSize &size)
