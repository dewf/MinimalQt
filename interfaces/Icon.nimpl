@nodispose
opaque Handle {
    static {
        options ModeStateOpts {
            Mode mode;
            State state;
        }
    }
    Size actualSize(Size size, ModeStateOpts opts);
    void addFile(string fileName, Option<Size> size, ModeStateOpts opts);
    void addPixmap(Pixmap.Handle pixmap, ModeStateOpts opts);
    Array<Size> availableSizes(ModeStateOpts opts);
    int64 cacheKey();
    bool isMask();
    bool isNull();
    string name();
    void paint(Painter.Handle painter, Rect rect, Option<Alignment> alignment, ModeStateOpts opts);
    void paint(Painter.Handle painter, int x, int y, int w, int h, Option<Alignment> alignment, ModeStateOpts opts);
    Pixmap.Owned pixmap(Size size, ModeStateOpts opts);
    Pixmap.Owned pixmap(int extent, ModeStateOpts opts);
    Pixmap.Owned pixmap(Size size, double devicePixelRatio, ModeStateOpts opts);
    Pixmap.Owned pixmap(int w, int h, ModeStateOpts opts);
    void setIsMask(bool isMask);
    void swap(Handle other);
}

opaque Owned extends Handle;

// constructors:
Owned create();
Owned create(Pixmap.Handle pixmap);
Owned create(string filename);
Owned create(Handle other);
// QIcon(QIconEngine *engine)


// static methods:
Array<string> fallbackSearchPaths();
string fallbackThemeName();
Owned fromTheme(string name);
Owned fromTheme(ThemeIcon icon);
Owned fromTheme(ThemeIcon icon, Handle fallback);
Owned fromTheme(string name, Handle fallback);
bool hasThemeIcon(string name);
bool hasThemeIcon(ThemeIcon icon);
void setFallbackSearchPaths(Array<string> paths);
void setFallbackThemeName(string name);
void setThemeName(string name);
void setThemeSearchPaths(Array<string> paths);
string themeName();
Array<string> themeSearchPaths();
