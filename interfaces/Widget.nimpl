module Widget;

import Object;
import Common;
import Layout;
import Painter;
import Icon;
import Enums;
import Action;
import Region;
import Cursor;
import SizePolicy;
import Font;
import MimeData;
import KeySequence;
import Pixmap;
import GraphicsEffect;
import PaintDevice;
import Variant;
import Event;
import Window;
import Screen;

int WIDGET_SIZE_MAX;   // pass-through of QWIDGETSIZE_MAX

interface SignalHandler extends Object.SignalHandler {
    void customContextMenuRequested(Point pos);
    void windowIconChanged(Icon.Handle icon);
    void windowTitleChanged(string title);
}

@withflags(RenderFlags)
enum RenderFlag {
    DrawWindowBackground = 0x1,
    DrawChildren = 0x2,
    IgnoreMask = 0x4
}

opaque Handle extends Object.Handle {

    bool acceptDrops();
    string accessibleDescription();
    string accessibleName();
    Array<Action.Handle> actions();
    void activateWindow();
    void addAction(Action.Handle action);
    Action.Handle addAction(string text);
    Action.Handle addAction(Icon.Handle icon, string text);
    Action.Handle addAction(string text, KeySequence.Handle shortcut);
    Action.Handle addAction(Icon.Handle icon, string text, KeySequence.Handle shortcut);

    // QAction * addAction(const QString &text, Args &&... args)
    // QAction * addAction(const QIcon &icon, const QString &text, Args &&... args)
    // QAction * addAction(const QString &text, const QKeySequence &shortcut, Args &&... args)
    // QAction * addAction(const QIcon &icon, const QString &text, const QKeySequence &shortcut, Args &&... args)
    // QAction * addAction(const QString &text, const QObject *receiver, const char *member, Qt::ConnectionType type = Qt::AutoConnection)
    // QAction * addAction(const QIcon &icon, const QString &text, const QObject *receiver, const char *member, Qt::ConnectionType type = Qt::AutoConnection)
    // QAction * addAction(const QString &text, const QKeySequence &shortcut, const QObject *receiver, const char *member, Qt::ConnectionType type = Qt::AutoConnection)
    // QAction * addAction(const QIcon &icon, const QString &text, const QKeySequence &shortcut, const QObject *receiver, const char *member, Qt::ConnectionType type = Qt::AutoConnection)

    void addActions(Array<Action.Handle> actions);
    void adjustSize();
    bool autoFillBackground();

    // QPalette::ColorRole backgroundRole() const
    // QBackingStore * backingStore() const

    Size baseSize();
    Handle childAt(int x, int y);
    Handle childAt(Point p);
    Handle childAt(PointF p);
    Rect childrenRect();
    Region.Owned childrenRegion();
    void clearFocus();
    void clearMask();
    Margins contentsMargins();
    Rect contentsRect();
    ContextMenuPolicy contextMenuPolicy();
    Cursor.Owned cursor();

    // WId effectiveWinId() const

    void ensurePolished();
    FocusPolicy focusPolicy();
    Handle focusProxy();
    Handle focusWidget();
    Font.Owned getFont();

    // QFontInfo fontInfo() const
    // QFontMetrics fontMetrics() const
    // QPalette::ColorRole foregroundRole() const

    Rect frameGeometry();
    Size frameSize();
    Rect geometry();
    Pixmap.Owned grab(Option<Rect> rectangle); // = QRect(QPoint(0, 0), QSize(-1, -1))
    void grabGesture(GestureType gesture, GestureFlags flags_ = 0);
    void grabKeyboard();
    void grabMouse();
    void grabMouse(Cursor.Handle cursor);
    int grabShortcut(KeySequence.Handle key, ShortcutContext context = WindowShortcut);
    GraphicsEffect.Handle graphicsEffect();

    // QGraphicsProxyWidget * graphicsProxyWidget() const

    // bool hasEditFocus() const
    // (only for embedded linux)

    bool hasFocus();
    bool hasHeightForWidth();
    bool hasMouseTracking();
    bool hasTabletTracking();
    int height();
    int heightForWidth(int w);
    InputMethodHints inputMethodHints();
    Variant.Owned inputMethodQuery(InputMethodQuery query);
    void insertAction(Action.Handle before, Action.Handle action);
    void insertActions(Action.Handle before, Array<Action.Handle> actions);
    bool isActiveWindow();
    bool isAncestorOf(Handle child);
    bool isEnabled();
    bool isEnabledTo(Handle ancestor);
    bool isFullScreen();
    bool isHidden();
    bool isMaximized();
    bool isMinimized();
    bool isModal();
    bool isVisible();
    bool isVisibleTo(Handle ancestor);
    bool isWindow();
    bool isWindowModified();
    Layout.Handle layout();
    LayoutDirection layoutDirection();

    // QLocale locale() const

    PointF mapFrom(Handle parent, PointF pos);
    Point mapFrom(Handle parent, Point pos);
    PointF mapFromGlobal(PointF pos);
    Point mapFromGlobal(Point pos);
    PointF mapFromParent(PointF pos);
    Point mapFromParent(Point pos);
    PointF mapTo(Handle parent, PointF pos);
    Point mapTo(Handle parent, Point pos);
    PointF mapToGlobal(PointF pos);
    Point mapToGlobal(Point pos);
    PointF mapToParent(PointF pos);
    Point mapToParent(Point pos);
    Region.Owned mask();
    int maximumHeight();
    Size maximumSize();
    int maximumWidth();
    int minimumHeight();
    Size minimumSize();
    Size minimumSizeHint();
    int minimumWidth();
    void move(Point p);
    void move(int x, int y);
    Handle nativeParentWidget();
    Handle nextInFocusChain();
    Rect normalGeometry();
    void overrideWindowFlags(WindowFlags flags_);

    // const QPalette & palette() const

    Handle parentWidget();
    Point pos();
    Handle previousInFocusChain();
    Rect rect();
    void releaseKeyboard();
    void releaseMouse();
    void releaseShortcut(int id);
    void removeAction(Action.Handle action);
    void render(PaintDevice.Handle target, Option<Point> targetOffset, Option<Region.Handle> sourceRegion, RenderFlags renderFlags = DrawWindowBackground | DrawChildren);
    void render(Painter.Handle painter, Option<Point> targetOffset, Option<Region.Handle> sourceRegion, RenderFlags renderFlags = DrawWindowBackground | DrawChildren);
    void repaint(Rect rect);
    void repaint(Region.Handle rgn);
    void repaint(int x, int y, int w, int h);
    void resize(Size size);
    void resize(int w, int h);
    bool restoreGeometry(Array<byte> geometry);
    Array<byte> saveGeometry();
    Screen.Handle screen();
    void scroll(int dx, int dy);
    void scroll(int dx, int dy, Rect r);
    void setAcceptDrops(bool on);
    void setAccessibleDescription(string description);
    void setAccessibleName(string name);
    void setAttribute(WidgetAttribute attribute, bool on = true);
    void setAutoFillBackground(bool enabled);

    // void setBackgroundRole(QPalette::ColorRole role)

    void setBaseSize(Size size);
    void setBaseSize(int basew, int baseh);
    void setContentsMargins(int left, int top, int right, int bottom);
    void setContentsMargins(Margins margins);
    void setContextMenuPolicy(ContextMenuPolicy policy);
    void setCursor(Cursor.Handle cursor);

    // void setEditFocus(bool enable)
    // (only for embedded linux)

    void setFixedHeight(int h);
    void setFixedSize(Size s);
    void setFixedSize(int w, int h);
    void setFixedWidth(int w);
    void setFocus(FocusReason reason);
    void setFocusPolicy(FocusPolicy policy);
    void setFocusProxy(Handle w);
    void setFont(Font.Handle font);

    // void setForegroundRole(QPalette::ColorRole role)

    void setGeometry(Rect r);
    void setGeometry(int x, int y, int w, int h);
    void setGraphicsEffect(GraphicsEffect.Handle effect);
    void setInputMethodHints(InputMethodHints hints);
    void setLayout(Layout.Handle layout);
    void setLayoutDirection(LayoutDirection direction);

    // void setLocale(const QLocale &locale)
    // void setMask(const QBitmap &bitmap)

    void setMask(Region.Handle region);
    void setMaximumHeight(int maxh);
    void setMaximumSize(Size size);
    void setMaximumSize(int maxw, int maxh);
    void setMaximumWidth(int maxw);
    void setMinimumHeight(int minh);
    void setMinimumSize(Size size);
    void setMinimumSize(int minw, int minh);
    void setMinimumWidth(int minw);
    void setMouseTracking(bool enable);

    // void setPalette(const QPalette &)

    void setParent(Handle parent);
    void setParent(Handle parent, WindowFlags f);
    void setScreen(Screen.Handle screen);
    void setShortcutAutoRepeat(int id, bool enable = true);
    void setShortcutEnabled(int id, bool enable = true);
    void setSizeIncrement(Size size);
    void setSizeIncrement(int w, int h);
    void setSizePolicy(SizePolicy.Handle policy);
    void setSizePolicy(SizePolicy.Policy horizontal, SizePolicy.Policy vertical);
    void setStatusTip(string tip);

    // void setStyle(QStyle *style)

    void setTabletTracking(bool enable);
    void setToolTip(string tip);
    void setToolTipDuration(int msec);
    void setUpdatesEnabled(bool enable);
    void setWhatsThis(string text);
    void setWindowFilePath(string filePath);
    void setWindowFlag(WindowType flag, bool on = true);
    void setWindowFlags(WindowFlags type_);
    void setWindowIcon(Icon.Handle icon);
    void setWindowModality(WindowModality windowModality);
    void setWindowOpacity(double level);
    void setWindowRole(string role);
    void setWindowState(WindowStates windowState);

    // void setupUi(QWidget *widget)
    // only for Designer-created things

    Size size();
    Size sizeHint();
    Size sizeIncrement();
    SizePolicy.Owned sizePolicy();
    void stackUnder(Handle w);
    string statusTip();

    // QStyle * style() const

    string styleSheet();
    bool testAttribute(WidgetAttribute attribute);
    string toolTip();
    int toolTipDuration();
    bool underMouse();
    void ungrabGesture(GestureType gesture);
    void unsetCursor();
    void unsetLayoutDirection();
    void unsetLocale();
    void update(Rect rect);
    void update(Region.Handle rgn);
    void update(int x, int y, int w, int h);
    void updateGeometry();
    bool updatesEnabled();
    Region.Owned visibleRegion();
    string whatsThis();
    int width();
    size_t winId();
    Handle window();
    string windowFilePath();
    WindowFlags getWindowFlags();
    Window.Handle windowHandle();
    Icon.Owned windowIcon();
    WindowModality getWindowModality();
    double windowOpacity();
    string windowRole();
    WindowStates windowState();
    string windowTitle();
    WindowType getWindowType();
    int x();
    int y();

    bool close();
    void hide();
    void lower();
    void raise();
    void repaint();
    void setDisabled(bool disable);
    void setEnabled(bool enable);
    void setFocus();
    void setHidden(bool hidden);
    void setStyleSheet(string styleSheet);
    void setVisible(bool visible);
    void setWindowModified(bool modified);
    void setWindowTitle(string title);
    void show();
    void showFullScreen();
    void showMaximized();
    void showMinimized();
    void showNormal();
    void update();

    // signals ======================================
    SignalConnection connect_CustomContextMenuRequested(SignalHandler handler);
    SignalConnection connect_WindowIconChanged(SignalHandler handler);
    SignalConnection connect_WindowTitleChanged(SignalHandler handler);
}

Handle create(Handle parent = null, WindowFlags flags_ = 0);

// SUBCLASSING ===========================================================

namedbits MethodMask {
    ShowEvent,
    PaintEvent,
    MousePressEvent,
    MouseMoveEvent,
    MouseReleaseEvent,
    EnterEvent,
    LeaveEvent,
    SizeHint,
    ResizeEvent,

    DropEvents      // dragenter, dragmove, dragleave
}

interface DelegateMethods {
    void showEvent(bool isSpontaneous);
    void paintEvent(Painter.Handle painter, Region.Handle region);
    void mousePressEvent(Point pos, MouseButton button, KeyboardModifiers modifiers);
    void mouseMoveEvent(Point pos, MouseButtons buttons, KeyboardModifiers modifiers);
    void mouseReleaseEvent(Point pos, MouseButton button, KeyboardModifiers modifiers);
    void enterEvent(Point pos);
    void leaveEvent();
    Size sizeHint();
    void resizeEvent(Size oldSize, Size newSize);

    // dragMove does double duty, also an 'enter' event - check isEnterEvent flag
    void dragMoveEvent(Point pos, KeyboardModifiers modifiers, MimeData.Handle mimeData, DragMoveEvent_Handle moveEvent, bool isEnterEvent);
    void dragLeaveEvent();
    void dropEvent(Point pos, KeyboardModifiers modifiers, MimeData.Handle mimeData, DropAction action);
}

opaque Delegated extends Handle;
// no interior/protected methods yet

Delegated createDelegated(DelegateMethods methods, MethodMask methodMask, Handle parent = null, WindowFlags flags_ = 0);
