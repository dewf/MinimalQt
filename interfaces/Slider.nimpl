module Slider;

import Object;
import Widget;
import Enums;
import AbstractSlider;

interface SignalHandler extends AbstractSlider.SignalHandler;

enum TickPosition {
    NoTicks = 0,
    TicksAbove = 1,
    TicksLeft = TicksAbove,
    TicksBelow = 2,
    TicksRight = TicksBelow,
    TicksBothSides = 3
}

opaque Handle extends AbstractSlider.Handle {
    int tickInterval();
    TickPosition tickPosition();
    void setTickInterval(int interval);
    void setTickPosition(TickPosition tpos);
}

Handle create(Option<Widget.Handle> parent);
Handle create(Orientation orientation, Option<Widget.Handle> parent);
