module ProgressBar;

import Object;
import Common;
import Enums;
import Icon;
import Widget;

interface SignalHandler extends Widget.SignalHandler {
    void valueChanged(int value);
}

enum Direction { TopToBottom, BottomToTop }

opaque Handle extends Widget.Handle {
    Alignment getAlignment();
    string format();
    bool invertedAppearance();
    bool isTextVisible();
    int maximum();
    int minimum();
    Orientation getOrientation();
    void resetFormat();
    void setAlignment(Alignment alignment);
    void setFormat(string format);
    void setInvertedAppearance(bool invert);
    void setTextDirection(Direction textDirection);
    void setTextVisible(bool visible);
    string text();
    Direction textDirection();
    int value();

    void reset();
    void setMaximum(int maximum);
    void setMinimum(int minimum);
    void setOrientation(Orientation orientation);
    void setRange(int minimum, int maximum);
    void setValue(int value);

    // signals ============================
    SignalConnection connect_ValueChanged(SignalHandler handler);
}

Handle create(Widget.Handle parent = null);
