module TreeView;

import Object;
import Common;
import Icon;
import Enums;
import AbstractItemView;
import ModelIndex;
import HeaderView;

namedbits SignalMask extends AbstractItemView.SignalMask {
    Collapsed,
    Expanded
}

interface SignalHandler extends AbstractItemView.SignalHandler {
    void collapsed(ModelIndex.Handle index);
    void expanded(ModelIndex.Handle index);
}

// some fancy stuff for the HeaderView getter:
delegate HeaderView.Handle HeaderViewWrapperCreateFunc(HeaderView.SignalHandler handler);
sumtype HeaderViewResult {
    NoHeaderView,
    AlreadyExists(HeaderView.Handle handle),             // something we (C#) created/assigned previously
    NeedsWrapper(HeaderViewWrapperCreateFunc createFunc) // Qt-created default: using the function, provide a SignalHandler, receive the HeadrView.Handle
}

opaque Handle extends AbstractItemView.Handle {
    // properties:
    bool allColumnsShowFocus();
    void setAllColumnsShowFocus(bool value);

    bool isAnimated();
    void setAnimated(bool value);

    int autoExpandDelay();
    void setAutoExpandDelay(int value);

    bool expandsOnDoubleClick();
    void setExpandsOnDoubleClick(bool value);

    bool isHeaderHidden();
    void setHeaderHidden(bool value);

    int indentation();
    void setIndentation(int value);
    void resetIndentation();

    bool itemsExpandable();
    void setItemsExpandable(bool value);

    bool rootIsDecorated();
    void setRootIsDecorated(bool value);

    bool isSortingEnabled();
    void setSortingEnabled(bool value);

    bool uniformRowHeights();
    void setUniformRowHeights(bool value);

    bool wordWrap();
    void setWordWrap(bool value);

    // methods:
    HeaderViewResult header();
    void resizeColumnToContents(int column);

    // etc:
    void setSignalMask(SignalMask mask);
}

Handle create(SignalHandler handler);
