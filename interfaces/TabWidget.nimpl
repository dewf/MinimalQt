module TabWidget;

import Object;
import Common;
import Icon;
import Enums;
import Widget;
import TabBar;

interface SignalHandler extends Widget.SignalHandler {
    void currentChanged(int index);
    void tabBarClicked(int index);
    void tabBarDoubleClicked(int index);
    void tabCloseRequested(int index);
}

enum TabShape { Rounded, Triangular }
enum TabPosition { North, South, West, East }

opaque Handle extends Widget.Handle {
    int addTab(Widget.Handle page, string label);
    int addTab(Widget.Handle page, Icon.Handle icon, string label);
    void clear();
    Widget.Handle cornerWidget(Corner corner = TopRightCorner);
    int count();
    int currentIndex();
    Widget.Handle currentWidget();
    bool documentMode();
    TextElideMode elideMode();
    Size iconSize();
    int indexOf(Widget.Handle w);
    int insertTab(int index, Widget.Handle page, string label);
    int insertTab(int index, Widget.Handle page, Icon.Handle icon, string label);
    bool isMovable();
    bool isTabEnabled(int index);
    bool isTabVisible(int index);
    void removeTab(int index);
    void setCornerWidget(Widget.Handle widget, Corner corner = TopRightCorner);
    void setDocumentMode(bool set);
    void setElideMode(TextElideMode mode);
    void setIconSize(Size size);
    void setMovable(bool movable);
    void setTabBarAutoHide(bool enabled);
    void setTabEnabled(int index, bool enable);
    void setTabIcon(int index, Icon.Handle icon);
    void setTabPosition(TabPosition position);
    void setTabShape(TabShape s);
    void setTabText(int index, string label);
    void setTabToolTip(int index, string tip);
    void setTabVisible(int index, bool visible);
    void setTabWhatsThis(int index, string text);
    void setTabsClosable(bool closeable);
    void setUsesScrollButtons(bool useButtons);
    TabBar.Handle tabBar();
    bool tabBarAutoHide();
    Icon.Owned tabIcon(int index);
    TabPosition getTabPosition();
    TabShape getTabShape();
    string tabText(int index);
    string tabToolTip(int index);
    string tabWhatsThis(int index);
    bool tabsClosable();
    bool usesScrollButtons();
    Widget.Handle widget(int index);
    
    void setCurrentIndex(int index);
    void setCurrentWidget(Widget.Handle widget);

    // signals =============================
    SignalConnection connect_CurrentChanged(SignalHandler handler);
    SignalConnection connect_TabBarClicked(SignalHandler handler);
    SignalConnection connect_TabBarDoubleClicked(SignalHandler handler);
    SignalConnection connect_TabCloseRequested(SignalHandler handler);
}

Handle create(Widget.Handle parent = null);
